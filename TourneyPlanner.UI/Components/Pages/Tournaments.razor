@page "/tournaments"
@using System.Drawing
@using System.Net
@using TourneyPlanner.UI.Models
@inject HttpClient Http
@inject AuthState AuthState

<PageTitle>Turneringar</PageTitle>

<h1>Turneringar</h1>
@if (AuthState.IsLoggedIn)
{
    <a class="btn btn-primary mb-3" href="create-tournament">Skapa ny</a>
}

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (successMessage != null)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (isLoading == true)
{
    <p>Laddar..</p>
}
else if (tournaments.Count == 0)
{
    <p>Det finns inga turneringar </p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th> Namn</th>
            <th>Status</th>
            <th>Start</th>
            <th>Slut</th>
            <th>Antal</th>
            <th>Åtgärder</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var t in tournaments)
        {
            <tr>
                <td>@t.Name</td>
                <td>@StatusText(t.Status)</td>
                <td>@t.StartDate.ToString("yyyy-MM-dd")</td>
                <td>@(t.EndDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                <td>@t.Size</td>
                <td>
                    <a class="btn btn-sm btn-primary me-1" href="tournaments/@t.Id/participants">
                        @(t.Status == "Draft" && AuthState.IsLoggedIn ? "Hantera deltagare" : "Deltagare")
                    </a>
                    
                    @if (t.Status != "Draft")
                    {
                        <a class="btn btn-sm btn-outline-primary" href="tournaments/@t.Id/schedule">Matchschema</a>
                        <a class="btn btn-sm btn-outline-primary me-1" href="tournaments/@t.Id/standings">Tabell</a>
                    }
                    
                    @if (AuthState.IsLoggedIn)
                    {
                        @if (t.Status == "Draft")
                        {
                            <a class="btn btn-sm btn-success" href="tournaments/@t.Id/edit">Redigera</a>
                            <button class="btn btn-sm btn-success" @onclick="(() => Start(t))" disabled="@isStarting">Starta</button>
                            <button class="btn btn-sm btn-danger" @onclick="(() => Delete(t))">Ta bort</button>
                        }
                        else if (t.Status == "Active")
                        {
                            <button class="btn btn-sm btn-warning" @onclick="() => Complete(t)">Avsluta</button>
                        }
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<TournamentModel> tournaments = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading = true;
    private bool isStarting;
    
    protected override async Task OnInitializedAsync()
    {
        await LoadTournaments();
    }

    private async Task LoadTournaments()
    {
        isLoading = true;

        try
        {
            tournaments = await Http.GetFromJsonAsync<List<TournamentModel>>("tournaments") ?? new();
        }
        catch (HttpRequestException)
        {
            errorMessage = "kunde inte nå APIet";
        }
        finally
        {
            isLoading = false;
        } 
       
    }

    private async Task Delete(TournamentModel tournament)
    {
        errorMessage = null;

        try
        {
            var response =  await Http.DeleteAsync("tournaments/" + tournament.Id);

            if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
            else if (!response.IsSuccessStatusCode && response.StatusCode != HttpStatusCode.NotFound)
            {
                errorMessage = "Något gfick fel försök igen";
            }
            else
            {
                await LoadTournaments();
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "Kunde inte nå APIet";
        }
    }

    private async Task Start(TournamentModel tournament)
    {
        // fix för errormessage även fast success
        if (isStarting == true)
        {
            return;
        }
        
        errorMessage = null;
        isStarting = true;

        try
        {
            var response = await Http.PostAsync($"tournaments/{tournament.Id}/start", null);

            if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
            else if (response.IsSuccessStatusCode || response.StatusCode == HttpStatusCode.NotFound)
            {
                // lyckad start eller om turneringen inte finns = ladda om listan
                await LoadTournaments();
            }
            else
            {
                errorMessage = "Något gick fel";
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "Kunde inte nå APIet";
        }
        finally
        {
            isStarting = false;
        }
    }

    private async Task Complete(TournamentModel tournament)
    {
        errorMessage = null;
        successMessage = null;

        try
        {
            var response = await Http.PostAsync($"tournaments/{tournament.Id}/complete", null);

            if (response.IsSuccessStatusCode)
            {
                var winner = await response.Content.ReadFromJsonAsync<StandingModel>();
                successMessage = $"Turneringen {tournament.Name} har avslutats, vinnaren är {winner.Name}!";
                await LoadTournaments();
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "Kunde inte nå API:et";
        }
    }

    private static string StatusText(string status)
    {
        if (status == "Draft")
        {
            return "Utkast";
        }
        if (status == "Active")
        {
            return "Pågående";
        }
        if (status == "Finished")
        {
            return "Avslutad";
        }
        
        return status;
    }
    

}